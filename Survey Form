<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Book preference Form</title>
    <link rel="stylesheet" href="styles.css" />
<head>
  </head>


<body>
<h1 id="title">Survey</h1>
<p id="description"> Please fill out the survey about the type of books and format you prefer.

<form id="survey-form">

<label for="name" id="name-label" >Enter your name:<input id="name" name="name" type= "text" placeholder="Your name" required><label/>
<label for="email" id="email-label">Enter your email:<input id="email" name="email" type= "email" placeholder="123@mail.com" required><label/>
<label for="number" id="number-label">Enter your age:<input id="number" name="number" type= "number" min="13" max="120" placeholder="Age" required><label/>


<label for="dropdown">Book format Preference:
<select id="dropdown">
  <option value="">(select one)</option>
  <option value="1" >Electronic</option>
  <option value="2" >Soft copy</option>
  <option value="3" >Hard copy</option>
</select>


 <fieldset>
      <legend>Rent or Buy:</legend>
      <label for="business-account"><input id="business-account" type="radio" name="pref-format" value="format" class="inline" />Rent</label>
      <label for="business-account"><input id="business-account" type="radio" name="pref-format" value="format" class="inline" />Rent</label>
</fieldset>

 <fieldset>
   <legend>Preffered catergory:</legend>
<label><input type="checkbox" value="catergory">Suspense<label/>
<label><input type="checkbox" value="catergory">Mystery<label/>
<label><input type="checkbox" value="catergory">Romance<label/>
<label><input type="checkbox" value="catergory">Non-Fiction<label/>
</fieldset>

<fieldset>
      <textarea id="top3" name="top3" rows="3" cols="30" placeholder="Your top recommendation"></textarea>
      </fieldset>


 <input type="submit" value="Submit" id="submit" />
    </form>
  </body>
</html>
